# Environment Configuration Example

# API Configuration
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# External Agents Configuration
# Set to false to disable external agents (default: false)
# Can be overridden with --enable-external-agents command line flag
ENABLE_EXTERNAL_AGENTS=false

# Hiverarchy External Agent Configuration (if external agents are enabled)
HIVERARCHY_EXTERNAL_ENDPOINT=http://localhost:4100/agents/orchestrator/orchestrator/tasks
HIVERARCHY_API_USER=your_hiverarchy_username
HIVERARCHY_API_PASSWORD=your_hiverarchy_password

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# Other Configuration
NODE_ENV=development