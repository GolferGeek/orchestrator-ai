# Required
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Format: sk-ant-api03-...
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - defaults shown
MODEL=claude-3-7-sonnet-20250219  # Recommended models: claude-3-7-sonnet-20250219, claude-3-opus-20240229
MAX_TOKENS=4000                   # Maximum tokens for model responses
TEMPERATURE=0.7                   # Temperature for model responses (0.0-1.0)
DEBUG=false                       # Enable debug logging (true/false)
LOG_LEVEL=info                    # Log level (debug, info, warn, error)
DEFAULT_SUBTASKS=3                # Default number of subtasks when expanding
DEFAULT_PRIORITY=medium           # Default priority for generated tasks (high, medium, low)
PROJECT_NAME=Orchestrator-AI      # Project name for tasks.json metadata
PROJECT_VERSION=1.0.0             # Project version for tasks.json metadata


# Emerging providers  
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Specialized providers

# Local (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_TEST_USER=test@example.com
SUPABASE_TEST_PASSWORD=test_password
SUPABASE_TEST_USERID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SUPABASE_DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

SYSTEM_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Supabase Schema Configuration
SUPABASE_CORE_SCHEMA=public
SUPABASE_COMPANY_SCHEMA=company

# External Agents Configuration
# Set to false to disable external agents (default: false)
# Can be overridden with --enable-external-agents command line flag
ENABLE_EXTERNAL_AGENTS=false

LOG_LEVEL=WARNING  # or DEBUG, INFO, ERROR as needed
PYTHONPATH=.:${PYTHONPATH}
TEST_API_SECRET_KEY=test-secret-key-12345
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Helicone 
HELICONE_API_KEY=sk-helicone-xxxxxxx-xxxxxxx-xxxxxxx-xxxxxxx

# Voice Stuff
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# Agent Base URL
AGENT_BASE_URL=http://localhost

# Heartbeat Configuration
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=10.0

# HTTP Client Configuration
HTTP_CLIENT_TIMEOUT=30.0

# A2A Protocol Configuration
A2A_PROTOCOL_VERSION=1.0.0

# A2A Agent Configuration
# Customize these values for your environment

AGENTS_API_PATH=/agents

# External Agents
HIVERARCHY_EXTERNAL_ENDPOINT=http://localhost:4100/agents/orchestrator/orchestrator/tasks
HIVERARCHY_API_USER=your_email@example.com
HIVERARCHY_API_PASSWORD=your_password

# =====================================
# A2A Protocol Settings
# =====================================
A2A_PROTOCOL_VERSION=2.0.0
DEFAULT_HEARTBEAT_INTERVAL=30
DEFAULT_REQUEST_TIMEOUT=30

# =====================================
# HTTP Client Configuration
# =====================================
A2A_MAX_RETRIES=3
A2A_RETRY_DELAY=1.0
A2A_RETRY_BACKOFF_MULTIPLIER=2.0

# =====================================
# Debugging and Logging
# =====================================
A2A_DEBUG=false
A2A_LOG_LEVEL=INFO
A2A_LOG_HEARTBEATS=false

# =====================================
# Agent Behavior
# =====================================
A2A_CONTEXT_FILE_NAME=agent_context.md
A2A_AUTO_REGISTER_FABRIC=true
A2A_AUTO_ESTABLISH_RELATIONSHIPS=true

VITE_BASE_URL=http://localhost
API_PORT=9000
WEB_PORT=9001

# LangSmith Configuration for Orchestra Evaluation
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=orchestrator-ai
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxx

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (VITE)
# =============================================================================
VITE_API_BASE_URL=http://localhost:9000
VITE_API_NESTJS_BASE_URL=http://localhost:9000
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false