# Local Ollama (if using local models)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# A2A PROTOCOL CONFIGURATION
# =============================================================================
A2A_PROTOCOL_VERSION=2.0.0
DEFAULT_HEARTBEAT_INTERVAL=30
DEFAULT_REQUEST_TIMEOUT=30
A2A_MAX_RETRIES=3
A2A_RETRY_DELAY=1.0
A2A_RETRY_BACKOFF_MULTIPLIER=2.0
A2A_DEBUG=false
A2A_LOG_LEVEL=INFO
A2A_LOG_HEARTBEATS=false
A2A_CONTEXT_FILE_NAME=agent_context.md
A2A_AUTO_REGISTER_FABRIC=true
A2A_AUTO_ESTABLISH_RELATIONSHIPS=true

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
ENABLE_EXTERNAL_AGENTS=true
AGENT_BASE_URL=http://localhost
AGENTS_API_PATH=/agents
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=10.0
HTTP_CLIENT_TIMEOUT=30.0

# External Agents (if applicable)
HIVERARCHY_EXTERNAL_ENDPOINT=http://localhost:4100/agents/orchestrator/orchestrator/tasks
HIVERARCHY_API_USER=your-username@example.com
HIVERARCHY_API_PASSWORD=your-password

# =============================================================================
# THIRD PARTY SERVICES (Replace with your actual API keys)
# =============================================================================
TEST_API_SECRET_KEY=test-secret-key-12345
FIRECRAWL_API_KEY=fc-your-actual-key-here
HELICONE_API_KEY=sk-helicone-your-actual-key-here
DEEPGRAM_API_KEY=your-deepgram-key-here
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
NOTION_API_KEY=ntn_your-notion-key-here

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=WARNING
PYTHONPATH=.:${PYTHONPATH}
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=orchestrator-ai
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key-here

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Production)
# =============================================================================
VITE_BASE_URL=http://localhost
VITE_API_BASE_URL=https://api.orchestratorai.io
VITE_API_NESTJS_BASE_URL=https://api.orchestratorai.io
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=true
# =============================================================================
# SOVEREIGN MODE CONFIGURATION
# =============================================================================
# Controls for local-only LLM usage and privacy enforcement

# Organization-level enforcement (true/false)
# When true, forces all users into sovereign mode regardless of their preference
SOVEREIGN_MODE_ENFORCED=false

# Default mode for new users/sessions (strict/relaxed)
# strict: Only local LLMs allowed by default
# relaxed: External LLMs allowed but with privacy warnings
SOVEREIGN_MODE_DEFAULT=relaxed

# Comma-separated list of allowed LLM providers in sovereign mode
# Example: "ollama,local" or "ollama" for strict local-only
SOVEREIGN_MODE_ALLOWED_PROVIDERS=ollama,local

# Audit logging level for sovereign mode compliance (none/basic/full)
# none: No sovereign mode audit logging
# basic: Log mode switches and policy violations
# full: Log all LLM requests and responses with privacy classification
SOVEREIGN_MODE_AUDIT_LEVEL=basic

# Enable real-time policy change propagation (true/false)
# When true, policy changes are immediately pushed to all active sessions
SOVEREIGN_MODE_REALTIME_UPDATES=true


# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Max Memory for this machine (in GB)
MAX_MODEL_MEMORY_GB=45



# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature flag for sovereign routing rollout

# Enable sovereign routing feature (true/false)
FEATURE_FLAG_SOVEREIGN_ROUTING_ENABLED=false

# Rollout percentage (0-100) - gradual rollout to users
FEATURE_FLAG_SOVEREIGN_ROUTING_ROLLOUT_PERCENTAGE=0

# Target specific users for early access (comma-separated user IDs)
# FEATURE_FLAG_SOVEREIGN_ROUTING_TARGET_USERS=user1,user2,user3

# Target specific organizations for early access (comma-separated org IDs)
# FEATURE_FLAG_SOVEREIGN_ROUTING_TARGET_ORGANIZATIONS=org1,org2

# Exclude specific users from the feature (comma-separated user IDs)
# FEATURE_FLAG_SOVEREIGN_ROUTING_EXCLUDE_USERS=

# Exclude specific organizations from the feature (comma-separated org IDs)
# FEATURE_FLAG_SOVEREIGN_ROUTING_EXCLUDE_ORGANIZATIONS=
