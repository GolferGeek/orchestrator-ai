{
  "name": "orchestrator-ai-monorepo",
  "private": true,
  "license": "PROPRIETARY",
  "packageManager": "npm@10.2.4",
  "scripts": {
    "contracts:generate": "turbo run generate --filter=@orchestrator-ai/shared-contracts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && ./start-dev.sh",
    "dev:web": "cd apps/web && npm run dev",
    "docker:build": "npm run docker:build",
    "docker:run": "npm run docker:run:api",
    "docker:run:api": "docker run --rm -d --name orchestrator-api -p 8000:8000 orchestrator-api",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "kill:9001": "lsof -ti:9001 | xargs kill -9 2>/dev/null || echo 'No process found on port 9001'",
    "kill:9000": "lsof -ti:9000 | xargs kill -9 2>/dev/null || echo 'No process found on port 9000'",
    "kill:4100": "lsof -ti:4100 | xargs kill -9 2>/dev/null || echo 'No process found on port 4100'",
    "kill:api": "npm run kill:9000"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "concurrently": "^8.2.2",
    "turbo": "^2.3.3"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "axios": "^1.10.0",
    "node-fetch": "^3.3.2",
    "quick-lru": "^7.0.1"
  }
}
