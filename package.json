{
  "name": "orchestrator-ai-monorepo",
  "private": true,
  "license": "PROPRIETARY",
  "scripts": {
    "contracts:generate": "turbo run generate --filter=@orchestrator-ai/shared-contracts-v1",
    "dev:api:fastapi": "cd apps/api/fastapi && PYTHONPATH=../../.. pdm run uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:api:nestjs": "cd apps/api/nestjs && ./start-dev.sh",
    "dev:web": "cd apps/web && npm run dev",
    "docker:build": "npm run docker:build",
    "docker:build:fastapi": "docker build -t orchestrator-fastapi -f apps/api/fastapi/Dockerfile .",
    "docker:run": "npm run docker:run:api",
    "docker:run:api": "docker run --rm -d --name orchestrator-api -p 8000:8000 orchestrator-api",
    "docker:stop": "npm run docker:stop:fastapi",
    "docker:stop:fastapi": "docker stop orchestrator-fastapi || true",
    "docker:logs:fastapi": "docker logs -f orchestrator-fastapi",
    "docker:clean": "npm run docker:stop && docker rmi orchestrator-fastapi || true",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "kill:4000": "lsof -ti:4000 | xargs kill -9 2>/dev/null || echo 'No process found on port 4000'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "turbo": "^2.3.3"
  },
  "workspaces": [
    "apps/web"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0"
  }
}
