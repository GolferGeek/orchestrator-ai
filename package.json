{
  "name": "orchestrator-ai-monorepo",
  "private": true,
  "license": "PROPRIETARY",
  "scripts": {
    "contracts:generate": "turbo run generate --filter=@orchestrator-ai/shared-contracts-v1",
    "dev": "concurrently \"npm run dev:api:v1\" \"npm run dev:web:v1\"",
    "dev:v1": "concurrently \"npm run dev:api:v1\" \"npm run dev:web:v1\"",
    "dev:api:v1": "cd apps/api/v1/fastapi && PYTHONPATH=../../../.. pdm run uvicorn apps.api.v1.fastapi.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:web:v1": "cd apps/web/v1 && npm run dev",
    "docker:build": "npm run docker:build:v1",
    "docker:build:v1": "docker build -t orchestrator-v1-api -f apps/api/v1/fastapi/Dockerfile .",
    "docker:run": "npm run docker:run:v1",
    "docker:run:v1": "docker run --rm -d --name orchestrator-v1 -p 8000:8000 orchestrator-v1-api",
    "docker:stop": "npm run docker:stop:v1",
    "docker:stop:v1": "docker stop orchestrator-v1 || true",
    "docker:logs:v1": "docker logs -f orchestrator-v1",
    "docker:clean": "npm run docker:stop && docker rmi orchestrator-v1-api || true",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "turbo": "^2.3.3"
  },
  "workspaces": [
    "apps/web/v1"
  ]
}
