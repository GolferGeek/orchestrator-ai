--
-- Name: mcp_execution_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.mcp_execution_summary AS
 SELECT me.id,
    me.mcp_name,
    me.tool_name,
    me.user_id,
    u.email AS user_email,
    u.display_name AS user_name,
    me.agent_conversation_id,
    ac.agent_name,
    ac.agent_type,
    me.status,
    me.execution_time_ms,
    me.llm_provider,
    me.llm_model,
    me.retry_count,
    me.context_used,
    me.created_at,
        CASE
            WHEN (mf.id IS NOT NULL) THEN true
            ELSE false
        END AS has_failure,
    mf.error_type,
    mf.error_code,
        CASE
            WHEN (mfb.id IS NOT NULL) THEN true
            ELSE false
        END AS has_feedback,
    mfb.rating,
    mfb.rating_score
   FROM ((((public.mcp_executions me
     LEFT JOIN public.users u ON ((me.user_id = u.id)))
     LEFT JOIN public.agent_conversations ac ON ((me.agent_conversation_id = ac.id)))
     LEFT JOIN public.mcp_failures mf ON ((me.id = mf.execution_id)))
     LEFT JOIN public.mcp_feedback mfb ON ((me.id = mfb.execution_id)));


ALTER TABLE public.mcp_execution_summary OWNER TO postgres;

--
-- Name: mcp_tool_usage; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.mcp_tool_usage (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    interaction_id uuid NOT NULL,
    tool_name text NOT NULL,
    tool_server text,
    tool_version text,
    execution_sequence integer DEFAULT 1,
    parameters_json jsonb DEFAULT '{}'::jsonb,
    result_json jsonb,
    execution_time_ms integer NOT NULL,
    memory_usage_bytes bigint,
    cpu_time_ms integer,
    status text NOT NULL,
    error_code text,
    error_message text,
    retry_count integer DEFAULT 0,
    context_json jsonb DEFAULT '{}'::jsonb,
    metadata_json jsonb DEFAULT '{}'::jsonb,
    input_validation_passed boolean DEFAULT true,
    output_validation_passed boolean DEFAULT true,
    security_checks_passed boolean DEFAULT true,
    started_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    completed_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    CONSTRAINT mcp_tool_usage_status_check CHECK ((status = ANY (ARRAY['success'::text, 'error'::text, 'timeout'::text, 'cancelled'::text])))
);


ALTER TABLE public.mcp_tool_usage OWNER TO postgres;

--
-- Name: TABLE mcp_tool_usage; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.mcp_tool_usage IS 'Tracking of Model Context Protocol tool usage within interactions';


--
-- Name: mcp_usage_analytics; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.mcp_usage_analytics AS
 SELECT mcp_executions.mcp_name,
    mcp_executions.tool_name,
    count(*) AS total_executions,
    count(*) FILTER (WHERE ((mcp_executions.status)::text = 'success'::text)) AS successful_executions,
    count(*) FILTER (WHERE ((mcp_executions.status)::text = 'error'::text)) AS failed_executions,
    round(avg(mcp_executions.execution_time_ms), 2) AS avg_execution_time_ms,
    count(DISTINCT mcp_executions.user_id) AS unique_users,
    count(*) FILTER (WHERE (mcp_executions.context_used = true)) AS context_used_count,
    date_trunc('day'::text, mcp_executions.created_at) AS execution_date
   FROM public.mcp_executions
  GROUP BY mcp_executions.mcp_name, mcp_executions.tool_name, (date_trunc('day'::text, mcp_executions.created_at))
  ORDER BY (date_trunc('day'::text, mcp_executions.created_at)) DESC, (count(*)) DESC;


ALTER TABLE public.mcp_usage_analytics OWNER TO postgres;

