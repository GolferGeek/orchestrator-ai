--
-- Name: organizational_agent_stats; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.organizational_agent_stats AS
 SELECT agent_conversations.agent_type,
    count(*) AS total_conversations,
    count(*) FILTER (WHERE (agent_conversations.ended_at IS NULL)) AS active_conversations,
    (avg(EXTRACT(epoch FROM (COALESCE(agent_conversations.ended_at, now()) - agent_conversations.started_at))) / (3600)::numeric) AS avg_duration_hours,
    max(agent_conversations.last_active_at) AS last_activity
   FROM public.agent_conversations
  GROUP BY agent_conversations.agent_type
  ORDER BY (count(*)) DESC;


ALTER TABLE public.organizational_agent_stats OWNER TO postgres;

