9d7c4ae9-024c-4483-8ca5-ec1904b1cfc1	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Can you tell me what companies had sales last year?", "query_type": "SELECT", "schema_tables": ["kpi_data", "companies"], "include_explanation": true}	{"sql": "SELECT COUNT(DISTINCT companies.id) FROM companies JOIN departments ON companies.id = departments.company_id JOIN kpi_data ON departments.id = kpi_data.department_id JOIN kpi_metrics ON kpi_data.metric_id = kpi_metrics.id WHERE kpi_metrics.name = 'Monthly Revenue' AND EXTRACT(YEAR FROM kpi_data.date_recorded) = EXTRACT(YEAR FROM CURRENT_DATE) - 1 LIMIT 1", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query counts the distinct companies that had sales recorded last year based on the 'Monthly Revenue' metric. It joins the 'companies', 'departments', 'kpi_data', and 'kpi_metrics' tables to ensure that we are only counting companies that have relevant sales data. The WHERE clause filters the results to include only those records where the metric name is 'Monthly Revenue' and the year of the recorded date is last year. The use of COUNT(DISTINCT companies.id) ensures that we are counting unique companies. The LIMIT 1 is added to comply with Supabase's requirement for safety in queries.", "execution_time_ms": 4716, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "medium"}, "context_patterns_applied": 1}	anthropic	claude-3-5-sonnet	4777	success	\N	7dda76ce-da35-448d-8e91-eecaa46bc722	0	f	2025-07-27 19:49:25.280423+00	2025-07-27 19:49:30.057155+00
