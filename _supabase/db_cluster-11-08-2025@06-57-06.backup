-- Name: get_table_names(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_table_names() RETURNS TABLE(table_name text)
    LANGUAGE sql SECURITY DEFINER
    AS $$
  SELECT t.table_name::text
  FROM information_schema.tables t
  WHERE t.table_schema = 'public'
    AND t.table_type = 'BASE TABLE'
  ORDER BY t.table_name;
$$;


ALTER FUNCTION public.get_table_names() OWNER TO postgres;

