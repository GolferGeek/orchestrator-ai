0:52.67996+00:00", "display_name": "nicholas_weber", "phone_verified": false}, {"id": "27133e18-6e95-4645-aeab-6ac9a736bdb9", "role": null, "email": "test@example.com", "phone": null, "locale": "en-US", "status": "active", "company": null, "location": null, "timezone": "UTC", "created_at": "2025-06-09T14:53:38.946412+00:00", "department": null, "updated_at": "2025-06-09T14:53:38.946412+00:00", "display_name": null, "phone_verified": false}], "success": true, "row_count": 6, "is_dry_run": false, "execution_time_ms": 68, "validation_results": {"is_safe": true, "estimated_cost": "low", "security_warnings": []}}	anthropic	claude-3-5-sonnet	132	success	\N	6491ff9f-3137-48c9-b482-3ddd86a2a83d	0	f	2025-07-26 01:41:34.247325+00	2025-07-26 01:41:34.384682+00
7f387d86-9987-4156-8934-c71c6c8ee0ec	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Find departments where the actual KPI values are more than 20% below their goals, and show the specific metrics that are underperforming", "use_context": true}	{"sql": "SELECT d.id, d.name, m.metric_name, m.actual_value, m.goal_value FROM departments d LEFT JOIN metrics m ON d.id = m.department_id WHERE m.actual_value < (m.goal_value * 0.8) LIMIT 100;", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query retrieves departments along with their specific metrics that are underperforming. It selects the department ID and name from the 'departments' table and the metric name, actual value, and goal value from the 'metrics' table. A LEFT JOIN is used to include all departments even if they have no associated metrics. The WHERE clause filters the results to include only those metrics where the actual value is less than 80% of the goal value, indicating they are more than 20% below their goals. Finally, a LIMIT clause is added to restrict the result set to 100 rows to prevent excessive data retrieval.", "execution_time_ms": 4641, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "medium"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	4712	success	\N	3ff6ed32-5018-4534-bd0f-3629f2eb2cd1	0	f	2025-07-26 02:12:30.304052+00	2025-07-26 02:12:35.064453+00
