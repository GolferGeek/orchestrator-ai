--
-- Name: tasks_with_message_stats; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.tasks_with_message_stats AS
SELECT
    NULL::uuid AS id,
    NULL::uuid AS agent_conversation_id,
    NULL::uuid AS user_id,
    NULL::text AS method,
    NULL::text AS prompt,
    NULL::jsonb AS params,
    NULL::text AS response,
    NULL::jsonb AS response_metadata,
    NULL::text AS status,
    NULL::integer AS progress,
    NULL::text AS progress_message,
    NULL::jsonb AS evaluation,
    NULL::jsonb AS llm_metadata,
    NULL::text AS error_code,
    NULL::text AS error_message,
    NULL::jsonb AS error_data,
    NULL::timestamp with time zone AS started_at,
    NULL::timestamp with time zone AS completed_at,
    NULL::integer AS timeout_seconds,
    NULL::jsonb AS metadata,
    NULL::timestamp with time zone AS created_at,
    NULL::timestamp with time zone AS updated_at,
    NULL::text AS deliverable_type,
    NULL::jsonb AS deliverable_metadata,
    NULL::bigint AS message_count,
    NULL::bigint AS progress_messages,
    NULL::bigint AS error_messages,
    NULL::bigint AS human_input_count,
    NULL::bigint AS pending_human_inputs,
    NULL::timestamp with time zone AS last_message_at;


ALTER TABLE public.tasks_with_message_stats OWNER TO postgres;

--
-- Name: user_audit_log; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.user_audit_log (
    audit_id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    user_id uuid,
    action character varying(100) NOT NULL,
    table_name character varying(100),
    record_id uuid,
    old_values jsonb,
    new_values jsonb,
    performed_by uuid,
    performed_by_type character varying(50),
    ip_address inet,
    user_agent text,
    "timestamp" timestamp with time zone DEFAULT now()
);


ALTER TABLE public.user_audit_log OWNER TO postgres;

--
-- Name: TABLE user_audit_log; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.user_audit_log IS 'Complete audit trail of all user data changes';


--
-- Name: user_cidafm_commands; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.user_cidafm_commands (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    type character varying(1) NOT NULL,
    name character varying(255) NOT NULL,
    description text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    CONSTRAINT user_cidafm_commands_type_check CHECK (((type)::text = ANY ((ARRAY['^'::character varying, '&'::character varying, '!'::character varying])::text[])))
);


ALTER TABLE public.user_cidafm_commands OWNER TO postgres;

--
-- Name: TABLE user_cidafm_commands; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.user_cidafm_commands IS 'User-created custom CIDAFM commands';


