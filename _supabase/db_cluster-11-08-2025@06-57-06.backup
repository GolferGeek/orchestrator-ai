12e1acda-2b98-47ec-8d7e-60064647b70d	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "\\n      WITH test_data AS (\\n        SELECT '{\\"city\\": \\"San Francisco\\", \\"state\\": \\"CA\\", \\"country\\": \\"USA\\"}'::text as json_text\\n      )\\n      INSERT INTO users (id, email, display_name, location) \\n      SELECT \\n        gen_random_uuid(), \\n        'location-test@example.com', \\n        'Location Test',\\n        json_text::json\\n      FROM test_data\\n      RETURNING id, location, pg_typeof(location) as pg_type;\\n    ", "format": "json", "dry_run": false}	{}	anthropic	claude-3-5-sonnet	141	error	Unsafe SQL: Only SELECT statements are allowed	a743bd62-c481-44b3-8cb3-1d9304d88ba3	0	f	2025-07-26 18:32:58.810106+00	2025-07-26 18:32:58.875927+00
