8a6e7de0-579c-45d3-a652-12ecec0ad204	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "SELECT companies.name, SUM(value) as total_revenue \\n    FROM companies \\n    JOIN departments ON companies.id = departments.company_id \\n    JOIN kpi_data ON departments.id = kpi_data.department_id \\n    JOIN kpi_metrics ON kpi_data.metric_id = kpi_metrics.id \\n    WHERE kpi_metrics.name = 'Monthly Revenue' \\n    AND kpi_data.date_recorded >= NOW() - INTERVAL '12 months' \\n    GROUP BY companies.id, companies.name \\n    ORDER BY total_revenue DESC \\n    LIMIT 5", "dry_run": false, "max_rows": 10}	{}	anthropic	claude-3-5-sonnet	221	error	Execution failed: "failed to parse select parameter (companies.name,SUM(value)astotal_revenue)" (line 1, column 11)	a0d59855-0d78-4bf9-843b-1b7a4c950c7f	0	f	2025-07-27 20:08:54.144711+00	2025-07-27 20:08:54.318947+00
e2815f2a-fca2-468c-8e55-8b562224d797	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Can you tell me what companies had sales last year?", "query_type": "SELECT", "schema_tables": ["kpi_data", "companies"], "include_explanation": true}	{"sql": "SELECT company_id FROM sales WHERE created_at >= DATE_TRUNC('year', NOW()) - INTERVAL '1 year' AND created_at < DATE_TRUNC('year', NOW()) LIMIT 100", "warnings": [], "confidence": 0.85, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query selects the 'company_id' from the 'sales' table where the 'created_at' date falls within the last year. The condition uses 'DATE_TRUNC' to get the start of the current year and subtracts one year to find the start of the last year. It also ensures that the 'created_at' date is less than the start of the current year. The LIMIT clause is included to comply with Supabase's safety requirements. Note that this query assumes there is a 'sales' table with a 'created_at' column and a 'company_id' column, which was not provided in the original schema. If the 'sales' table does not exist, this query would need to be adjusted based on the actual schema.", "execution_time_ms": 3966, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	4042	success	\N	f65f98f9-a295-4a29-b056-7553edd9281d	0	f	2025-07-27 15:51:04.063135+00	2025-07-27 15:51:08.099234+00
