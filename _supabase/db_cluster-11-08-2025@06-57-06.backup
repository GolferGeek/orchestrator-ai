COMMENT ON COLUMN public.agent_health_status.status IS 'Current health status: healthy, degraded, unhealthy, offline, unknown';


--
-- Name: COLUMN agent_health_status.relationship_health_issues; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agent_health_status.relationship_health_issues IS 'JSONB array of relationship IDs with health issues';


--
-- Name: COLUMN agent_health_status.dependent_agents_count; Type: COMMENT; Schema: public; Owner: postgres
