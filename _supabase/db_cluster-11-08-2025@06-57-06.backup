    NULL::text AS agent_name,
    NULL::text AS agent_type,
    NULL::timestamp with time zone AS started_at,
    NULL::timestamp with time zone AS ended_at,
    NULL::timestamp with time zone AS last_active_at,
    NULL::jsonb AS metadata,
    NULL::timestamp with time zone AS created_at,
    NULL::timestamp with time zone AS updated_at,
    NULL::bigint AS task_count,
    NULL::bigint AS completed_tasks,
    NULL::bigint AS failed_tasks,
    NULL::bigint AS active_tasks,
    NULL::text AS organizational_group;


ALTER TABLE public.agent_conversations_with_stats OWNER TO postgres;

