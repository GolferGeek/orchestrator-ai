--
-- Name: users Admins can read all profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can read all profiles" ON public.users FOR SELECT TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.users users_1
  WHERE ((users_1.id = auth.uid()) AND ('admin'::text = ANY (users_1.roles))))));


--
-- Name: users Admins can update user roles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can update user roles" ON public.users FOR UPDATE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.users users_1
  WHERE ((users_1.id = auth.uid()) AND ('admin'::text = ANY (users_1.roles)))))) WITH CHECK ((EXISTS ( SELECT 1
   FROM public.users users_1
  WHERE ((users_1.id = auth.uid()) AND ('admin'::text = ANY (users_1.roles))))));


--
-- Name: cidafm_commands Allow admin to manage builtin cidafm commands; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow admin to manage builtin cidafm commands" ON public.cidafm_commands TO service_role USING (true) WITH CHECK (true);


--
-- Name: models Allow admin to manage models; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow admin to manage models" ON public.models TO service_role USING (true) WITH CHECK (true);


--
-- Name: providers Allow admin to manage providers; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow admin to manage providers" ON public.providers TO service_role USING (true) WITH CHECK (true);


--
-- Name: user_usage_stats Allow admin to read all usage stats; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow admin to read all usage stats" ON public.user_usage_stats FOR SELECT TO service_role USING (true);


--
-- Name: cidafm_commands Allow authenticated users to read builtin cidafm commands; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow authenticated users to read builtin cidafm commands" ON public.cidafm_commands FOR SELECT TO authenticated USING ((is_builtin = true));


--
-- Name: models Allow authenticated users to read models; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow authenticated users to read models" ON public.models FOR SELECT TO authenticated USING (((status)::text = 'active'::text));


--
-- Name: providers Allow authenticated users to read providers; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow authenticated users to read providers" ON public.providers FOR SELECT TO authenticated USING (((status)::text = 'active'::text));


--
-- Name: user_cidafm_commands Allow users to manage their own cidafm commands; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow users to manage their own cidafm commands" ON public.user_cidafm_commands TO authenticated USING ((auth.uid() = user_id)) WITH CHECK ((auth.uid() = user_id));


--
-- Name: user_usage_stats Allow users to read their own usage stats; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow users to read their own usage stats" ON public.user_usage_stats FOR SELECT TO authenticated USING ((auth.uid() = user_id));


