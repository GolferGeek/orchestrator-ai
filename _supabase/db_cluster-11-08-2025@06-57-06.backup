 "training_data_cutoff": "2024-10-01", "model_parameters_json": {"top_p": 1, "max_tokens": 8192, "temperature": 0.7}}, {"id": "f32889ba-e3ac-495f-9c6c-9a2c19594452", "is_active": true, "created_at": "2025-06-02T16:18:44.205991+00:00", "model_name": "claude-4-sonnet-20250219", "model_type": "text-generation", "updated_at": "2025-06-02T16:18:44.205991+00:00", "provider_id": "8e42c293-a4ea-4735-84a3-5fe9d88585f9", "capabilities": ["function_calling", "streaming", "vision"], "display_name": "Claude 4 Sonnet", "model_version": "20250219", "context_window": 200000, "max_output_tokens": 8192, "pricing_info_json": {"currency": "USD", "input_cost_per_token": 0.000003, "output_cost_per_token": 0.000015}, "training_data_cutoff": "2024-10-01", "model_parameters_json": {"top_p": 1, "max_tokens": 8192, "temperature": 0.7}}, {"id": "70e6a241-bec4-4e58-9e3b-7b0eaf9e70e9", "is_active": true, "created_at": "2025-06-02T16:18:44.205991+00:00", "model_name": "deepseek-r1:latest", "model_type": "text-generation", "updated_at": "2025-06-02T16:18:44.205991+00:00", "provider_id": "27e27074-94a5-440c-9a5a-6bc8a949819f", "capabilities": ["reasoning", "streaming"], "display_name": "DeepSeek-R1 Latest", "model_version": "latest", "context_window": 32768, "max_output_tokens": 8192, "pricing_info_json": {"currency": "USD", "cost_model": "local"}, "training_data_cutoff": "2024-06-01", "model_parameters_json": {"top_p": 0.8, "max_tokens": 8192, "temperature": 0.7}}, {"id": "a6732bfd-9c2c-4669-a9f7-21102446d6bb", "is_active": true, "created_at": "2025-06-02T16:18:44.205991+00:00", "model_name": "llama3.2:latest", "model_type": "text-generation", "updated_at": "2025-06-02T16:18:44.205991+00:00", "provider_id": "27e27074-94a5-440c-9a5a-6bc8a949819f", "capabilities": ["streaming", "function_calling"], "display_name": "Llama 3.2 Latest", "model_version": "latest", "context_window": 131072, "max_output_tokens": 8192, "pricing_info_json": {"currency": "USD", "cost_model": "local"}, "training_data_cutoff":