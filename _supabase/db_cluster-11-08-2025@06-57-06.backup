cefe8143-c13b-4455-904b-8963f5e7a230	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Top 5 companies by revenue in the last year", "query_type": "SELECT", "schema_tables": ["kpi_data", "companies"], "include_explanation": true}	{"sql": "SELECT companies.name, SUM(value) FROM companies JOIN departments ON companies.id = departments.company_id JOIN kpi_data ON departments.id = kpi_data.department_id JOIN kpi_metrics ON kpi_data.metric_id = kpi_metrics.id WHERE kpi_metrics.name = 'Monthly Revenue' AND kpi_data.date_recorded >= NOW() - INTERVAL '12 months' GROUP BY companies.id, companies.name ORDER BY SUM(value) DESC LIMIT 10", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query retrieves the top 5 companies based on their total revenue over the last year. It follows the required Supabase PostgREST constraints by using full table names without aliases in the SELECT clause. The query joins the 'companies', 'departments', 'kpi_data', and 'kpi_metrics' tables to access the necessary data. It filters the results to include only those records where the metric name is 'Monthly Revenue' and the date recorded is within the last 12 months. The results are grouped by company ID and name to calculate the total revenue for each company. Finally, it orders the results in descending order based on the total revenue and limits the output to the top 10 companies. The use of LIMIT 10 ensures safety and compliance with Supabase constraints.", "execution_time_ms": 4952, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "medium"}, "context_patterns_applied": 1}	anthropic	claude-3-5-sonnet	5072	success	\N	f6086314-c4f0-4bd0-8156-1765e2677b99	0	f	2025-07-28 00:15:18.069142+00	2025-07-28 00:15:23.105117+00
