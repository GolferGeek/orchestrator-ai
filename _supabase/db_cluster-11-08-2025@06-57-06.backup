56279017-34d6-4da5-a234-38ae610fe68d	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "How many companies had sales last year?", "query_type": "SELECT", "schema_tables": ["companies", "kpi_data", "departments", "kpi_metrics"], "include_explanation": true}	{"sql": "SELECT COUNT(DISTINCT company_id) FROM sales WHERE EXTRACT(YEAR FROM sale_date) = EXTRACT(YEAR FROM CURRENT_DATE) - 1 LIMIT 1", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query counts the number of distinct companies that had sales in the previous year. It uses the COUNT function to aggregate the results and the DISTINCT keyword to ensure that each company is only counted once. The WHERE clause filters the sales records to include only those where the sale_date falls within the last year. The EXTRACT function is used to get the year from the sale_date and compare it to the previous year. Finally, a LIMIT clause is included to comply with Supabase's requirement for safety, ensuring that only one result is returned.", "execution_time_ms": 3681, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	3741	success	\N	fc29bbaa-70dc-40e3-98d4-53fe657e9e26	0	f	2025-07-27 15:40:45.693241+00	2025-07-27 15:40:49.430957+00
9168b274-9d36-41eb-860c-8af00e86edb7	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "How many companies had sales last year?", "query_type": "SELECT", "schema_tables": ["companies", "kpi_data"], "include_explanation": true}	{"sql": "SELECT COUNT(DISTINCT company_id) FROM sales WHERE EXTRACT(YEAR FROM sale_date) = EXTRACT(YEAR FROM NOW()) - 1 LIMIT 1", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query counts the distinct number of companies that had sales in the previous year. It uses the COUNT function to aggregate the results. The WHERE clause filters the sales records to include only those where the sale_date falls within the last year, determined by extracting the year from the current date and subtracting one. The DISTINCT keyword ensures that each company is only counted once, even if they had multiple sales. The LIMIT clause is included to comply with Supabase's safety requirements, ensuring that the query does not return an excessive number of rows.", "execution_time_ms": 3289, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	3352	success	\N	4d192477-d399-48f6-baa3-c43268b87acf	0	f	2025-07-27 15:39:48.876136+00	2025-07-27 15:39:52.242722+00
