--

CREATE POLICY "Service role has full access to langgraph_state_history" ON public.langgraph_state_history TO service_role USING (true) WITH CHECK (true);


--
-- Name: langgraph_states Service role has full access to langgraph_states; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role has full access to langgraph_states" ON public.langgraph_states TO service_role USING (true) WITH CHECK (true);


--
-- Name: mcp_failures System can create MCP failure records; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "System can create MCP failure records" ON public.mcp_failures FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.mcp_executions
  WHERE ((mcp_executions.id = mcp_failures.execution_id) AND (mcp_executions.user_id = auth.uid())))));


--
-- Name: human_inputs System can create human inputs for any user; Type: POLICY; Schema: public; Owner: postgres
