CREATE TABLE public.human_inputs (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    task_id uuid NOT NULL,
    user_id uuid NOT NULL,
    request_type text NOT NULL,
    prompt text NOT NULL,
    options jsonb,
