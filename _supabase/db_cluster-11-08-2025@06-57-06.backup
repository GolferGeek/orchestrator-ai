--
-- Name: tasks; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.tasks (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    agent_conversation_id uuid,
    user_id uuid NOT NULL,
    method text NOT NULL,
    prompt text NOT NULL,
    params jsonb DEFAULT '{}'::jsonb,
    response text,
    response_metadata jsonb DEFAULT '{}'::jsonb,
    status text DEFAULT 'pending'::text NOT NULL,
    progress integer DEFAULT 0,
    progress_message text,
    evaluation jsonb DEFAULT '{}'::jsonb,
    llm_metadata jsonb DEFAULT '{}'::jsonb,
    error_code text,
    error_message text,
    error_data jsonb,
    started_at timestamp with time zone,
    completed_at timestamp with time zone,
    timeout_seconds integer DEFAULT 300,
    metadata jsonb DEFAULT '{}'::jsonb,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    deliverable_type text DEFAULT 'text'::text,
    deliverable_metadata jsonb DEFAULT '{}'::jsonb,
    CONSTRAINT tasks_progress_check CHECK (((progress >= 0) AND (progress <= 100))),
    CONSTRAINT tasks_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'running'::text, 'waiting_for_human'::text, 'completed'::text, 'failed'::text, 'cancelled'::text])))
);


ALTER TABLE public.tasks OWNER TO postgres;

--
-- Name: TABLE tasks; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.tasks IS 'Stores individual tasks within agent conversations. Access controlled via API authentication.';


--
-- Name: COLUMN tasks.evaluation; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.tasks.evaluation IS 'Stores evaluation results from LLM evaluation system';


--
-- Name: COLUMN tasks.llm_metadata; Type: COMMENT; Schema: public; Owner: postgres
