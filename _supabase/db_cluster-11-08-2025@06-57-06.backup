--
-- Name: agent_relationships; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.agent_relationships (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    source_agent_id uuid NOT NULL,
    target_agent_id uuid NOT NULL,
    relationship_type text NOT NULL,
    trust_level numeric(3,2) DEFAULT 0.5,
    delegation_permissions jsonb DEFAULT '[]'::jsonb,
    interaction_count integer DEFAULT 0,
    success_rate numeric(3,2) DEFAULT 1.0,
    average_response_time_ms integer DEFAULT 0,
    last_successful_interaction timestamp with time zone,
    priority_level integer DEFAULT 5,
    notes text,
    is_active boolean DEFAULT true,
    bidirectional boolean DEFAULT false,
    established_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    CONSTRAINT agent_relationships_check CHECK ((source_agent_id <> target_agent_id)),
    CONSTRAINT agent_relationships_priority_level_check CHECK (((priority_level >= 1) AND (priority_level <= 10))),
    CONSTRAINT agent_relationships_relationship_type_check CHECK ((relationship_type = ANY (ARRAY['can_delegate_to'::text, 'reports_to'::text, 'collaborates_with'::text, 'manages'::text, 'provides_service_to'::text, 'depends_on'::text, 'orchestrates'::text]))),
    CONSTRAINT agent_relationships_success_rate_check CHECK (((success_rate >= 0.0) AND (success_rate <= 1.0))),
    CONSTRAINT agent_relationships_trust_level_check CHECK (((trust_level >= 0.0) AND (trust_level <= 1.0)))
);


ALTER TABLE public.agent_relationships OWNER TO postgres;

--
-- Name: TABLE agent_relationships; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.agent_relationships IS 'Stores relationships between agents for delegation, reporting, and collaboration';


--
-- Name: COLUMN agent_relationships.relationship_type; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agent_relationships.relationship_type IS 'Type of relationship: can_delegate_to, reports_to, collaborates_with, manages, provides_service_to, depends_on, orchestrates';


--
-- Name: COLUMN agent_relationships.trust_level; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agent_relationships.trust_level IS 'Trust level for delegation decisions (0.0 to 1.0)';


--
-- Name: COLUMN agent_relationships.delegation_permissions; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agent_relationships.delegation_permissions IS 'JSONB array of task types that can be delegated in this relationship';


--
-- Name: COLUMN agent_relationships.priority_level; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agent_relationships.priority_level IS 'Priority level for delegation routing (1=highest, 10=lowest)';


--
-- Name: COLUMN agent_relationships.bidirectional; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agent_relationships.bidirectional IS 'Whether the relationship applies in both directions';


--
-- Name: agents; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.agents (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    name text NOT NULL,
    display_name text NOT NULL,
    description text,
    agent_type text,
    model_id uuid,
    fallback_model_id uuid,
    system_prompt text,
    configuration_json jsonb DEFAULT '{}'::jsonb,
    tools_available jsonb DEFAULT '[]'::jsonb,
    max_iterations integer DEFAULT 10,
    temperature numeric(3,2) DEFAULT 0.7,
    max_tokens integer,
    is_active boolean DEFAULT true,
    version text DEFAULT '1.0.0'::text,
    created_by uuid,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    parent_id uuid,
    relationships_json jsonb DEFAULT '[]'::jsonb,
    can_delegate boolean DEFAULT true,
    can_receive_delegations boolean DEFAULT true,
    max_delegation_depth integer DEFAULT 3,
    explanation text,
    CONSTRAINT agents_agent_type_check CHECK ((agent_type = ANY (ARRAY['orchestrator'::text, 'manager'::text, 'specialist'::text, 'external'::text]))),
    CONSTRAINT agents_max_delegation_depth_check CHECK (((max_delegation_depth >= 0) AND (max_delegation_depth <= 10)))
);


ALTER TABLE public.agents OWNER TO postgres;

--
-- Name: TABLE agents; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.agents IS 'Stores configuration and metadata for AI agents';


--
-- Name: COLUMN agents.parent_id; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agents.parent_id IS 'Reference to parent agent for hierarchical relationships (manager/supervisor)';


--
-- Name: COLUMN agents.explanation; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.agents.explanation IS 'Detailed explanation of agent behavior, capabilities, and purpose - more comprehensive than the basic description field';


--
-- Name: agent_hierarchy; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.agent_hierarchy AS
 WITH RECURSIVE hierarchy AS (
         SELECT a.id,
            a.name,
            a.display_name,
            a.agent_type,
            NULL::uuid AS parent_id,
            0 AS level,
            ARRAY[a.id] AS path
           FROM public.agents a
          WHERE (NOT (a.id IN ( SELECT ar.source_agent_id
                   FROM public.agent_relationships ar
                  WHERE ((ar.relationship_type = 'reports_to'::text) AND (ar.is_active = true)))))
        UNION ALL
         SELECT a.id,
            a.name,
            a.display_name,
            a.agent_type,
            ar.target_agent_id AS parent_id,
            (h.level + 1),
            (h.path || a.id)
           FROM ((public.agents a
             JOIN public.agent_relationships ar ON ((a.id = ar.source_agent_id)))
             JOIN hierarchy h ON ((ar.target_agent_id = h.id)))
          WHERE ((ar.relationship_type = 'reports_to'::text) AND (ar.is_active = true) AND (NOT (a.id = ANY (h.path))))
        )
 SELECT hierarchy.id,
    hierarchy.name,
    hierarchy.display_name,
    hierarchy.agent_type,
    hierarchy.parent_id,
    hierarchy.level,
    hierarchy.path
   FROM hierarchy
  ORDER BY hierarchy.level, hierarchy.name;


ALTER TABLE public.agent_hierarchy OWNER TO postgres;

--
-- Name: agent_interactions; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.agent_interactions (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    agent_id uuid NOT NULL,
    user_id uuid NOT NULL,
    session_id uuid,
    conversation_id uuid,
    parent_interaction_id uuid,
    user_input text NOT NULL,
    agent_response text,
    interaction_type text,
    status text DEFAULT 'pending'::text,
    error_message text,
    response_time_ms integer,
    total_tokens integer,
    cost_usd numeric(10,6),
    metadata_json jsonb DEFAULT '{}'::jsonb,
    context_json jsonb DEFAULT '{}'::jsonb,
    started_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    completed_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    CONSTRAINT agent_interactions_interaction_type_check CHECK ((interaction_type = ANY (ARRAY['chat'::text, 'task'::text, 'function_call'::text, 'tool_use'::text, 'workflow_step'::text]))),
    CONSTRAINT agent_interactions_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'processing'::text, 'completed'::text, 'error'::text, 'timeout'::text])))
);


ALTER TABLE public.agent_interactions OWNER TO postgres;

--
-- Name: TABLE agent_interactions; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.agent_interactions IS 'Stores all interactions between users and agents with performance metrics';


--
-- Name: agent_relationships_with_details; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.agent_relationships_with_details AS
 SELECT ar.id,
    ar.source_agent_id,
    ar.target_agent_id,
    ar.relationship_type,
    ar.trust_level,
    ar.delegation_permissions,
    ar.interaction_count,
    ar.success_rate,
    ar.average_response_time_ms,
    ar.last_successful_interaction,
    ar.priority_level,
    ar.notes,
    ar.is_active,
    ar.bidirectional,
    ar.established_at,
    ar.created_at,
    ar.updated_at,
    sa.name AS source_agent_name,
    sa.display_name AS source_agent_display_name,
    sa.agent_type AS source_agent_type,
    ta.name AS target_agent_name,
    ta.display_name AS target_agent_display_name,
    ta.agent_type AS target_agent_type,
    hs.status AS target_agent_health_status,
    hs.last_heartbeat AS target_agent_last_heartbeat
   FROM (((public.agent_relationships ar
     JOIN public.agents sa ON ((ar.source_agent_id = sa.id)))
     JOIN public.agents ta ON ((ar.target_agent_id = ta.id)))
     LEFT JOIN public.agent_health_status hs ON ((ar.target_agent_id = hs.agent_id)));


ALTER TABLE public.agent_relationships_with_details OWNER TO postgres;

--
-- Name: cidafm_commands; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.cidafm_commands (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    type character varying(1) NOT NULL,
    name character varying(255) NOT NULL,
    description text,
    default_active boolean DEFAULT false,
    is_builtin boolean DEFAULT true,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    CONSTRAINT cidafm_commands_type_check CHECK (((type)::text = ANY ((ARRAY['^'::character varying, '&'::character varying, '!'::character varying])::text[])))
);


ALTER TABLE public.cidafm_commands OWNER TO postgres;

--
-- Name: TABLE cidafm_commands; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.cidafm_commands IS 'Built-in CIDAFM (AI Function Module) commands';


--
-- Name: COLUMN cidafm_commands.type; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.cidafm_commands.type IS 'CIDAFM command type: ^ (response modifier), & (state modifier), ! (execution command)';


--
-- Name: COLUMN cidafm_commands.name; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.cidafm_commands.name IS 'Command name used in prompts (without the type prefix)';


--
-- Name: COLUMN cidafm_commands.description; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.cidafm_commands.description IS 'Detailed description of what the command does';


--
-- Name: COLUMN cidafm_commands.default_active; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.cidafm_commands.default_active IS 'Whether this command is active by default (mainly for & state modifiers)';


--
-- Name: COLUMN cidafm_commands.is_builtin; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.cidafm_commands.is_builtin IS 'Whether this is a built-in command or user-created custom command';


--
-- Name: cidafm_commands_by_type; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.cidafm_commands_by_type AS
 SELECT cidafm_commands.type,
    ((cidafm_commands.type)::text || (cidafm_commands.name)::text) AS full_command,
    cidafm_commands.name,
    cidafm_commands.description,
    cidafm_commands.default_active,
    cidafm_commands.is_builtin,
        CASE
            WHEN ((cidafm_commands.type)::text = '^'::text) THEN 'Response Modifier'::text
            WHEN ((cidafm_commands.type)::text = '&'::text) THEN 'State Modifier'::text
            WHEN ((cidafm_commands.type)::text = '!'::text) THEN 'Execution Command'::text
            ELSE NULL::text
        END AS type_description,
    cidafm_commands.created_at
   FROM public.cidafm_commands
  WHERE (cidafm_commands.is_builtin = true)
  ORDER BY cidafm_commands.type, cidafm_commands.name;


ALTER TABLE public.cidafm_commands_by_type OWNER TO postgres;

--
-- Name: VIEW cidafm_commands_by_type; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.cidafm_commands_by_type IS 'View of CIDAFM commands organized by type with helpful descriptions';


