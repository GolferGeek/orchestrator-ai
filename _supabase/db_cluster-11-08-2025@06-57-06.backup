COMMENT ON COLUMN public.tasks.deliverable_type IS 'Type of deliverable produced by the task (text, json, file, etc.)';


--
-- Name: COLUMN tasks.deliverable_metadata; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.tasks.deliverable_metadata IS 'Additional metadata about the deliverable structure and content';


--
-- Name: human_inputs_with_task_context; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.human_inputs_with_task_context AS
 SELECT hi.id,
    hi.task_id,
    hi.user_id,
    hi.request_type,
    hi.prompt,
    hi.options,
    hi.user_response,
    hi.response_metadata,
    hi.status,
    hi.timeout_at,
    hi.created_at,
    hi.updated_at,
    t.method AS task_method,
    t.status AS task_status,
    t.agent_conversation_id,
    ac.agent_name,
    ac.agent_type
   FROM ((public.human_inputs hi
     JOIN public.tasks t ON ((t.id = hi.task_id)))
     JOIN public.agent_conversations ac ON ((ac.id = t.agent_conversation_id)));


ALTER TABLE public.human_inputs_with_task_context OWNER TO postgres;

