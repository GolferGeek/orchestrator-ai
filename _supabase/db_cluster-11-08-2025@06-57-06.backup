le": true, "primary_key": false, "default_value": null}, {"name": "created_at", "type": "text", "nullable": false, "primary_key": false, "default_value": "timezone('utc'::text, now())"}, {"name": "updated_at", "type": "text", "nullable": false, "primary_key": false, "default_value": "timezone('utc'::text, now())"}, {"name": "phone", "type": "text", "nullable": true, "primary_key": false, "default_value": null}, {"name": "phone_verified", "type": "boolean", "nullable": true, "primary_key": false, "default_value": null}, {"name": "company", "type": "text", "nullable": true, "primary_key": false, "default_value": null}, {"name": "role", "type": "text", "nullable": true, "primary_key": false, "default_value": null}, {"name": "department", "type": "text", "nullable": true, "primary_key": false, "default_value": null}, {"name": "location", "type": "text", "nullable": true, "primary_key": false, "default_value": null}, {"name": "timezone", "type": "text", "nullable": true, "primary_key": false, "default_value": "UTC"}, {"name": "locale", "type": "text", "nullable": true, "primary_key": false, "default_value": "en-US"}, {"name": "status", "type": "text", "nullable": true, "primary_key": false, "default_value": "active"}], "hasData": true, "purpose": "User management, authentication, and user-related data storage", "recordCount": 0, "businessContext": "User Management"}]}, "total_tables": 44, "execution_time_ms": 0}	anthropic	claude-3-5-sonnet	66	success	\N	89dd2147-af06-41fd-9364-ce7dda87a0b9	0	f	2025-07-26 20:15:25.309125+00	2025-07-26 20:15:25.423408+00
d70e83c6-c00f-45b8-bcc6-5b23702602d0	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "List all LLM providers and their models, showing total usage count, average execution time, and success rate for each model", "use_context": true}	{"sql": "SELECT mcp.tool_name AS llm_provider, mcp.mcp_name AS model, COUNT(mcp.id) AS total_usage_count, AVG(mcp.execution_time_ms) AS average_execution_time, SUM(CASE WHEN mcp.status = 'success' THEN 1 ELSE 0 END) * 100.0 / COUNT(mcp.id) AS success_rate FROM mcp_executions mcp GROUP BY mcp.tool_name, mcp.mcp_name ORDER BY llm_provider, model LIMIT 100;", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "1. The query selects the tool_name as llm_provider and mcp_name as model from the mcp_executions table. 2. It counts the total number of executions for each model using COUNT(mcp.id) to get total_usage_count. 3. It calculates the average execution time in milliseconds using AVG(mcp.execution_time_ms) for average_execution_time. 4. The success rate is calculated by summing the number of successful executions (where status is 'success') and dividing it by the total count of executions, then multiplying by 100 to get a percentage. 5. The results are grouped by llm_provider and model to aggregate the data correctly. 6. Finally, the results are ordered by llm_provider and model, and limited to 100 results to avoid large result sets.", "execution_time_ms": 7154, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	7225	success	\N	e5beda33-fe67-432b-8658-ca9caf43dce0	0	f	2025-07-26 02:19:30.174854+00	2025-07-26 02:19:37.481748+00
2abc725f-a4fe-4a8b-a719-42b3b78c187e	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show me a monthly trend of agent conversations by organizational type for the past 6 months, including the number of completed vs incomplete conversations", "use_context": true}	{"sql": "SELECT DATE_TRUNC('month', ac.started_at) AS month, ac.agent_type, COUNT(ac.id) AS total_conversations, SUM(CASE WHEN ac.ended_at IS NOT NULL THEN 1 ELSE 0 END) AS completed_conversations, SUM(CASE WHEN ac.ended_at IS NULL THEN 1 ELSE 0 END) AS incomplete_conversations FROM agent_conversations ac WHERE ac.started_at >= NOW() - INTERVAL '6 months' GROUP BY month, ac.agent_type ORDER BY month, ac.agent_type;", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "1. The query starts by selecting the month of each conversation using DATE_TRUNC('month', ac.started_at) to group the results by month. 2. It also selects the agent_type from the agent_conversations table. 3. COUNT(ac.id) counts the total number of conversations for each month and agent type. 4. The SUM with a CASE statement counts the number of completed conversations (where ended_at is not NULL) and the number of incomplete conversations (where ended_at is NULL). 5. The WHERE clause filters the conversations to only include those that started in the past 6 months. 6. The results are grouped by month and agent_type to provide a breakdown of conversations by type for each month. 7. Finally, the results are ordered by month and agent_type for better readability.", "execution_time_ms": 8936, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	9063	success	\N	8958db9a-37d0-41a0-b8b0-2f972b2d4e51	0	f	2025-07-26 02:19:37.899948+00	2025-07-26 02:19:46.950936+00
5d62118b-8f2a-45c8-a081-c8efb18a5ab4	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "SELECT ac.agent_type, COUNT(t.id) AS total_successful_tasks, SUM(me.execution_time_ms) / 3600000.0 AS total_execution_time_hours, COUNT(t.id) / (SUM(me.execution_time_ms) / 3600000.0) AS cost_efficiency FROM agent_conversations ac LEFT JOIN tasks t ON ac.id = t.agent_conversation_id AND t.status = 'successful' LEFT JOIN mcp_executions me ON ac.id = me.agent_conversation_id GROUP BY ac.agent_type ORDER BY cost_efficiency DESC;", "dry_run": false}	{"data": [{"count": 25}], "success": true, "row_count": 1, "is_dry_run": false, "execution_time_ms": 87, "validation_results": {"is_safe": true, "estimated_cost": "medium", "security_warnings": []}}	anthropic	claude-3-5-sonnet	162	success	\N	123a5a1a-9236-4da1-95ce-5bba163285f3	0	f	2025-07-26 02:20:03.965928+00	2025-07-26 02:20:04.166065+00
