5329ea6f-f1e2-426f-b24e-7bdf3b4aa116	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "SELECT ac.agent_type, COUNT(t.id) AS total_successful_tasks, SUM(me.execution_time_ms) / 3600000.0 AS total_execution_time_hours, (COUNT(t.id) / (SUM(me.execution_time_ms) / 3600000.0)) AS cost_efficiency FROM agent_conversations ac LEFT JOIN tasks t ON ac.id = t.agent_conversation_id AND t.status = 'successful' LEFT JOIN mcp_executions me ON ac.id = me.agent_conversation_id GROUP BY ac.agent_type ORDER BY cost_efficiency DESC;", "dry_run": true}	{"success": true, "is_dry_run": true, "execution_time_ms": 0, "validation_results": {"is_safe": true, "estimated_cost": "medium", "security_warnings": []}}	anthropic	claude-3-5-sonnet	74	success	\N	a65a49b3-0ed9-48cd-837e-5412be1d8b4f	0	f	2025-07-26 02:13:07.781852+00	2025-07-26 02:13:07.858894+00
bdacc4ff-7d0a-4106-8792-ab99ff9d9dc4	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show me all companies and their departments ranked by KPI performance, including a breakdown of which specific metrics each department excels or lags in", "use_context": true}	{"sql": "SELECT c.id AS company_id, c.name AS company_name, d.id AS department_id, d.name AS department_name, k.metric_name, k.performance_score FROM companies c LEFT JOIN departments d ON c.id = d.company_id LEFT JOIN kpi_performance k ON d.id = k.department_id ORDER BY k.performance_score DESC", "warnings": [], "confidence": 0.8, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query retrieves a list of companies along with their departments and the KPI performance metrics for each department. It starts by selecting the company ID and name from the 'companies' table. It then performs a LEFT JOIN with the 'departments' table to include all departments associated with each company, even if a company has no departments. Another LEFT JOIN is performed with the 'kpi_performance' table to get the performance metrics for each department. The results are ordered by the performance score in descending order to rank the departments based on their KPI performance. This ensures that departments that excel in their metrics appear first in the results.", "execution_time_ms": 4684, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "medium"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	4750	success	\N	2fb27db1-0aec-487c-94dc-421eacdbf436	0	f	2025-07-26 02:13:07.927606+00	2025-07-26 02:13:12.719517+00
