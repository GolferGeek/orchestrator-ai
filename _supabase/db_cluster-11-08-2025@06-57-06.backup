--
-- Name: tasks_with_message_stats _RETURN; Type: RULE; Schema: public; Owner: postgres
--

CREATE OR REPLACE VIEW public.tasks_with_message_stats AS
 SELECT t.id,
    t.agent_conversation_id,
    t.user_id,
    t.method,
    t.prompt,
    t.params,
    t.response,
    t.response_metadata,
    t.status,
    t.progress,
    t.progress_message,
    t.evaluation,
    t.llm_metadata,
    t.error_code,
    t.error_message,
    t.error_data,
    t.started_at,
    t.completed_at,
    t.timeout_seconds,
    t.metadata,
    t.created_at,
    t.updated_at,
    t.deliverable_type,
    t.deliverable_metadata,
    count(tm.id) AS message_count,
    count(tm.id) FILTER (WHERE (tm.message_type = 'progress'::text)) AS progress_messages,
    count(tm.id) FILTER (WHERE (tm.message_type = 'error'::text)) AS error_messages,
    count(hi.id) AS human_input_count,
    count(hi.id) FILTER (WHERE (hi.status = 'pending'::text)) AS pending_human_inputs,
    max(tm.created_at) AS last_message_at
   FROM ((public.tasks t
     LEFT JOIN public.task_messages tm ON ((tm.task_id = t.id)))
     LEFT JOIN public.human_inputs hi ON ((hi.task_id = t.id)))
  GROUP BY t.id;


--
-- Name: agent_conversations_with_stats _RETURN; Type: RULE; Schema: public; Owner: postgres
--

CREATE OR REPLACE VIEW public.agent_conversations_with_stats AS
 SELECT ac.id,
    ac.user_id,
    ac.agent_name,
    ac.agent_type,
    ac.started_at,
    ac.ended_at,
    ac.last_active_at,
    ac.metadata,
    ac.created_at,
    ac.updated_at,
    count(t.id) AS task_count,
    count(t.id) FILTER (WHERE (t.status = 'completed'::text)) AS completed_tasks,
    count(t.id) FILTER (WHERE (t.status = 'failed'::text)) AS failed_tasks,
    count(t.id) FILTER (WHERE (t.status = ANY (ARRAY['pending'::text, 'running'::text]))) AS active_tasks,
        CASE
            WHEN (ac.agent_type = 'orchestrator'::text) THEN 'management'::text
            WHEN (ac.agent_type = 'specialist'::text) THEN 'cross_functional'::text
            ELSE ac.agent_type
        END AS organizational_group
   FROM (public.agent_conversations ac
     LEFT JOIN public.tasks t ON ((t.agent_conversation_id = ac.id)))
  GROUP BY ac.id;


