665736e0-12fb-4fe1-9c84-887cd1c5f6ce	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "tell me about last year's sales", "use_context": true}	{"sql": "SELECT * FROM mcp_executions WHERE created_at >= DATE_TRUNC('year', CURRENT_DATE) - INTERVAL '1 year' AND created_at < DATE_TRUNC('year', CURRENT_DATE) LIMIT 100", "warnings": [], "confidence": 0.85, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query retrieves all records from the 'mcp_executions' table where the 'created_at' timestamp falls within the last calendar year. The 'DATE_TRUNC' function is used to get the start of the current year, and then we subtract one year to get the start of last year. We also ensure that the 'created_at' timestamp is less than the start of the current year to only include records from the previous year. The 'LIMIT 100' clause is added to restrict the result set to the first 100 records, which is useful for performance and readability. Note that this query assumes that 'sales' data is represented in the 'mcp_executions' table, as there is no specific 'sales' table in the provided schema.", "execution_time_ms": 4892, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	5046	success	\N	0f2d6783-66b1-40de-b23c-00944acea894	0	f	2025-07-26 01:34:35.285383+00	2025-07-26 01:34:40.305984+00
