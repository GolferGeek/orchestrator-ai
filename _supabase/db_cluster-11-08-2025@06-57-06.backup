-- Name: relationship_exists(uuid, uuid, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.relationship_exists(source_id uuid, target_id uuid, rel_type text) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN EXISTS (
        SELECT 1 FROM agent_relationships 
        WHERE source_agent_id = source_id 
          AND target_agent_id = target_id 
          AND relationship_type = rel_type
          AND is_active = true
    );
END;
$$;


