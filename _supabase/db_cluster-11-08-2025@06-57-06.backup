b3a14a31-063f-4388-9531-55b246570481	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show MCP tool usage statistics", "use_context": true}	{"sql": "SELECT mcp_name, tool_name, COUNT(*) AS usage_count, SUM(execution_time_ms) AS total_execution_time_ms, AVG(execution_time_ms) AS average_execution_time_ms\\nFROM mcp_executions\\nGROUP BY mcp_name, tool_name\\nORDER BY usage_count DESC\\nLIMIT 100;", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query retrieves statistics on the usage of MCP tools from the mcp_executions table. It selects the mcp_name and tool_name, and calculates three metrics: the total count of executions (usage_count), the total execution time in milliseconds (total_execution_time_ms), and the average execution time in milliseconds (average_execution_time_ms). The results are grouped by both mcp_name and tool_name to provide a breakdown of usage per tool under each MCP. The results are ordered by usage_count in descending order to show the most used tools first. Finally, a LIMIT clause is applied to restrict the output to the top 100 results, ensuring that the query remains efficient and manageable in size.", "execution_time_ms": 4408, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	4464	success	\N	78944138-1c9f-440b-8e1b-6311843ba95b	0	f	2025-07-26 01:30:58.205583+00	2025-07-26 01:31:02.726249+00
