--
-- Name: remove_user_role(uuid, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.remove_user_role(user_id uuid, role_to_remove text) RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
    UPDATE users 
    SET roles = array_remove(roles, role_to_remove)
    WHERE id = user_id;
    
    -- Ensure user always has at least the 'user' role
    UPDATE users 
    SET roles = ARRAY['user']
    WHERE id = user_id 
    AND (roles IS NULL OR array_length(roles, 1) IS NULL OR array_length(roles, 1) = 0);
END;
$$;


ALTER FUNCTION public.remove_user_role(user_id uuid, role_to_remove text) OWNER TO postgres;

--
-- Name: save_langgraph_state_history(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.save_langgraph_state_history() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Only save history if state_version has changed
    IF OLD.state_version != NEW.state_version THEN
        INSERT INTO langgraph_state_history (
            project_id,
            state_version,
            plan_state,
            step_results,
            metadata,
            rollback_reason
        ) VALUES (
            OLD.project_id,
            OLD.state_version,
            OLD.plan_state,
            OLD.step_results,
            OLD.metadata,
            'Automatic backup before version ' || NEW.state_version
        );
    END IF;
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.save_langgraph_state_history() OWNER TO postgres;

--
-- Name: search_deliverables(text, text, text, integer, integer); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.search_deliverables(search_term text DEFAULT NULL::text, filter_type text DEFAULT NULL::text, filter_format text DEFAULT NULL::text, limit_count integer DEFAULT 50, offset_count integer DEFAULT 0) RETURNS TABLE(id uuid, title text, deliverable_type text, format text, version integer, is_latest_version boolean, created_at timestamp with time zone, updated_at timestamp with time zone, created_by_agent text, content_preview text, tags text[])
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
    RETURN QUERY
    SELECT 
        d.id,
        d.title,
        d.deliverable_type,
        d.format,
        d.version,
        d.is_latest_version,
        d.created_at,
        d.updated_at,
        d.created_by_agent,
        LEFT(d.content, 200) || CASE WHEN LENGTH(d.content) > 200 THEN '...' ELSE '' END as content_preview,
        d.tags
    FROM public.deliverables d
    WHERE d.user_id = auth.uid()
    AND (search_term IS NULL OR (
        d.title ILIKE '%' || search_term || '%' 
        OR d.content ILIKE '%' || search_term || '%'
        OR EXISTS (SELECT 1 FROM unnest(d.tags) tag WHERE tag ILIKE '%' || search_term || '%')
    ))
    AND (filter_type IS NULL OR d.deliverable_type = filter_type)
    AND (filter_format IS NULL OR d.format = filter_format)
    ORDER BY d.updated_at DESC
    LIMIT limit_count
    OFFSET offset_count;
END;
$$;


ALTER FUNCTION public.search_deliverables(search_term text, filter_type text, filter_format text, limit_count integer, offset_count integer) OWNER TO postgres;

--
-- Name: trigger_log_role_changes(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.trigger_log_role_changes() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Only log if roles actually changed
    IF OLD.roles IS DISTINCT FROM NEW.roles THEN
        INSERT INTO role_audit_log (
            user_id,
            admin_user_id,
            action,
            old_roles,
            new_roles,
            reason
        ) VALUES (
            NEW.id,
            COALESCE(auth.uid(), NEW.id), -- Use auth.uid() if available, otherwise assume self-update
            'set_roles',
            OLD.roles,
            NEW.roles,
            'Role change detected'
        );
    END IF;
    
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.trigger_log_role_changes() OWNER TO postgres;

