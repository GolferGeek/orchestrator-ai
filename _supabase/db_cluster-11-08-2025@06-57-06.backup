COMMENT ON TABLE public.user_privacy_settings IS 'User privacy preferences and GDPR compliance';


--
-- Name: user_roles_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.user_roles_summary AS
 SELECT u.id,
    u.email,
    u.display_name,
    u.roles,
    u.created_at,
    u.updated_at,
    array_length(u.roles, 1) AS role_count,
        CASE
            WHEN ('admin'::text = ANY (u.roles)) THEN true
            ELSE false
        END AS is_admin,
        CASE
            WHEN ('evaluation-monitor'::text = ANY (u.roles)) THEN true
            ELSE false
        END AS is_evaluation_monitor
   FROM public.users u;


ALTER TABLE public.user_roles_summary OWNER TO postgres;

--
-- Name: VIEW user_roles_summary; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.user_roles_summary IS 'Summary view of all users with role information and computed flags';


