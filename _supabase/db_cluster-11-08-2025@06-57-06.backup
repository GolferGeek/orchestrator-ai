2613080b-c7dd-4e42-9728-7196b7461657	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show me which users have the highest task completion rate and list their top 3 most frequently used agent types", "use_context": true}	{"sql": "WITH task_completion AS (  SELECT user_id, COUNT(*) AS total_tasks, SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) AS completed_tasks  FROM tasks  GROUP BY user_id), completion_rate AS (  SELECT user_id, completed_tasks::float / total_tasks AS rate  FROM task_completion  WHERE total_tasks > 0), agent_usage AS (  SELECT ac.user_id, ac.agent_type, COUNT(*) AS usage_count  FROM agent_conversations ac  JOIN tasks t ON ac.id = t.agent_conversation_id  GROUP BY ac.user_id, ac.agent_type), ranked_agents AS (  SELECT user_id, agent_type, usage_count, ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY usage_count DESC) AS rank  FROM agent_usage) SELECT cu.user_id, cu.rate, ra.agent_type  FROM completion_rate cu  JOIN ranked_agents ra ON cu.user_id = ra.user_id  WHERE ra.rank <= 3  ORDER BY cu.rate DESC, cu.user_id;", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "1. The first CTE (Common Table Expression) named 'task_completion' calculates the total number of tasks and the number of completed tasks for each user by grouping the tasks table by user_id. 2. The second CTE 'completion_rate' computes the completion rate for each user by dividing the number of completed tasks by the total number of tasks, filtering out users with zero tasks. 3. The third CTE 'agent_usage' counts how many times each agent type has been used by each user by joining the agent_conversations table with the tasks table on the agent_conversation_id. 4. The fourth CTE 'ranked_agents' ranks the agent types for each user based on their usage count using ROW_NUMBER(). 5. Finally, the main SELECT statement retrieves the user_id and their completion rate from 'completion_rate' and the top 3 agent types from 'ranked_agents', ordering the results by completion rate in descending order and user_id.", "execution_time_ms": 9052, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "high"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	9115	success	\N	fc129705-93d2-4b29-b64b-33a72332a81c	0	f	2025-07-26 02:12:20.846732+00	2025-07-26 02:12:30.076802+00
b024bd8b-82a6-4013-8a5f-993b42760153	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "WITH task_completion AS (  SELECT user_id, COUNT(*) AS total_tasks, SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) AS completed_tasks  FROM tasks  GROUP BY user_id), completion_rate AS (  SELECT user_id, completed_tasks::float / total_tasks AS rate  FROM task_completion  WHERE total_tasks > 0), agent_usage AS (  SELECT ac.user_id, ac.agent_type, COUNT(*) AS usage_count  FROM agent_conversations ac  JOIN tasks t ON ac.id = t.agent_conversation_id  GROUP BY ac.user_id, ac.agent_type), ranked_agents AS (  SELECT user_id, agent_type, usage_count, ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY usage_count DESC) AS rank  FROM agent_usage) SELECT cu.user_id, cu.rate, ra.agent_type  FROM completion_rate cu  JOIN ranked_agents ra ON cu.user_id = ra.user_id  WHERE ra.rank <= 3  ORDER BY cu.rate DESC, cu.user_id;", "dry_run": true}	{"success": true, "is_dry_run": true, "execution_time_ms": 0, "validation_results": {"is_safe": true, "estimated_cost": "high", "security_warnings": []}}	anthropic	claude-3-5-sonnet	86	success	\N	0ce2f4ea-ce4e-4ff9-9f78-fa1c169f8323	0	f	2025-07-26 02:12:30.155151+00	2025-07-26 02:12:30.230934+00
