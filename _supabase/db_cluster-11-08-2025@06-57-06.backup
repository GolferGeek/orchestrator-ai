a7e1753b-cc41-40bd-a21b-e328d5c4f6ef	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show me the average execution time of MCP tools for the last 30 days", "use_context": true}	{"sql": "SELECT AVG(execution_time_ms) FROM mcp_executions WHERE created_at >= NOW() - INTERVAL '30 days' LIMIT 1", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query calculates the average execution time of MCP tools from the 'mcp_executions' table for the last 30 days. It uses the AVG function to compute the average of the 'execution_time_ms' column. The WHERE clause filters the records to include only those created in the last 30 days by comparing the 'created_at' timestamp with the current time minus 30 days. The LIMIT clause is included to comply with Supabase's requirement for safety, ensuring that only one result is returned. This query adheres to all Supabase constraints, avoiding aliases, calculated fields, and complex joins.", "execution_time_ms": 3910, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	4024	success	\N	42c558ea-1582-42c3-b8ff-ec03aeca4689	0	f	2025-07-26 02:31:13.953543+00	2025-07-26 02:31:17.932461+00
