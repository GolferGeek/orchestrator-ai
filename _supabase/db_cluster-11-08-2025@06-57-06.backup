18195e27-cd91-4e22-a482-aa64892d9f25	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "How many companies had sales last year?", "query_type": "SELECT", "schema_tables": ["companies", "kpi_data"], "include_explanation": true}	{"sql": "SELECT COUNT(DISTINCT companies.id) FROM companies JOIN departments ON companies.id = departments.company_id JOIN kpi_data ON departments.id = kpi_data.department_id JOIN kpi_metrics ON kpi_data.metric_id = kpi_metrics.id WHERE kpi_metrics.name = 'Monthly Revenue' AND EXTRACT(YEAR FROM kpi_data.date_recorded) = EXTRACT(YEAR FROM CURRENT_DATE) - 1 LIMIT 1", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query counts the distinct number of companies that had sales recorded in the previous year. It joins four tables: companies, departments, kpi_data, and kpi_metrics. The join between companies and departments is established through the company_id foreign key, and the join between departments and kpi_data is established through the department_id foreign key. The kpi_metrics table is joined to filter the results specifically for the 'Monthly Revenue' metric. The date filter ensures that only records from the previous year are considered by using the EXTRACT function to compare the year of the date_recorded field with the current year minus one. Finally, a LIMIT of 1 is added to comply with Supabase's requirement for safety in queries.", "execution_time_ms": 5480, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "medium"}, "context_patterns_applied": 1}	anthropic	claude-3-5-sonnet	5547	success	\N	aaf34a5c-5b22-4e00-8c6f-53a2b9d57a74	0	f	2025-07-27 19:43:07.90872+00	2025-07-27 19:43:13.511621+00
