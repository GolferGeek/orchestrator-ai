    success_count integer DEFAULT 0,
    health_check_url text,
    last_health_check timestamp with time zone,
    health_check_response text,
    health_check_error text,
    relationship_health_issues jsonb DEFAULT '[]'::jsonb,
    dependent_agents_count integer DEFAULT 0,
    metadata_json jsonb DEFAULT '{}'::jsonb,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    CONSTRAINT agent_health_status_status_check CHECK ((status = ANY (ARRAY['healthy'::text, 'degraded'::text, 'unhealthy'::text, 'offline'::text, 'unknown'::text])))
);


ALTER TABLE public.agent_health_status OWNER TO postgres;

