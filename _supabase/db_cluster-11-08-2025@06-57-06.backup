585f58d9-a56d-4230-899f-9a6334d35486	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "SELECT companies.name, SUM(value) as total_revenue \\nFROM companies \\nJOIN departments ON companies.id = departments.company_id \\nJOIN kpi_data ON departments.id = kpi_data.department_id \\nJOIN kpi_metrics ON kpi_data.metric_id = kpi_metrics.id \\nWHERE kpi_metrics.name = 'Monthly Revenue' \\nAND kpi_data.date_recorded >= NOW() - INTERVAL '12 months' \\nGROUP BY companies.id, companies.name \\nORDER BY total_revenue DESC \\nLIMIT 5", "dry_run": false, "max_rows": 5}	{"data": [{"name": "RetailMax LLC", "total_revenue": 215260523.63000003}, {"name": "ServicePro Co", "total_revenue": 209550618.5499999}, {"name": "TechCorp Inc", "total_revenue": 175301171.29999995}, {"name": "TechCorp Industries", "total_revenue": 150957897.05999997}, {"name": "RetailMax Solutions", "total_revenue": 147922450.84000003}], "success": true, "row_count": 5, "is_dry_run": false, "execution_time_ms": 312, "validation_results": {"is_safe": true, "estimated_cost": "medium", "security_warnings": []}}	anthropic	claude-3-5-sonnet	378	success	\N	9014f3f5-9a88-4db2-8cef-705dd054573e	0	f	2025-07-27 20:27:26.707588+00	2025-07-27 20:27:27.084611+00
cf65137b-ec4c-41ff-8d8e-2fb9003242de	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show me the top 5 companies by revenue in the last year", "query_type": "SELECT", "schema_tables": ["kpi_data", "companies"], "include_explanation": true}	{"sql": "SELECT companies.name, SUM(value) as total_revenue FROM companies JOIN departments ON companies.id = departments.company_id JOIN kpi_data ON departments.id = kpi_data.department_id JOIN kpi_metrics ON kpi_data.metric_id = kpi_metrics.id WHERE kpi_metrics.name = 'Monthly Revenue' AND kpi_data.date_recorded >= NOW() - INTERVAL '12 months' GROUP BY companies.id, companies.name ORDER BY total_revenue DESC LIMIT 5", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query retrieves the top 5 companies by revenue over the last year. It starts by selecting the company names and the sum of their revenue values. The query joins the 'companies', 'departments', 'kpi_data', and 'kpi_metrics' tables to access the necessary data. It filters the results to only include records where the metric name is 'Monthly Revenue' and the date recorded is within the last 12 months. The results are grouped by company ID and name to aggregate the revenue values, and then ordered in descending order by total revenue. Finally, it limits the output to the top 5 companies to meet the requirement of the query.", "execution_time_ms": 5403, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "medium"}, "context_patterns_applied": 1}	anthropic	claude-3-5-sonnet	5515	success	\N	27054a80-4cf5-46c7-bf01-3d95c0594e78	0	f	2025-07-29 12:12:37.571803+00	2025-07-29 12:12:43.097639+00
