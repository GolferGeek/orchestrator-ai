    CONSTRAINT mcp_feedback_rating_check CHECK (((rating)::text = ANY ((ARRAY['up'::character varying, 'down'::character varying])::text[]))),
    CONSTRAINT mcp_feedback_rating_score_check CHECK (((rating_score >= 1) AND (rating_score <= 5)))
);


