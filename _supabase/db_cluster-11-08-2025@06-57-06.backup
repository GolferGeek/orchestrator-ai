f8525bc6-3f22-44f7-abc1-2e7699a9ff85	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "SELECT DATE_TRUNC('month', ac.started_at) AS month, ac.agent_type, COUNT(ac.id) AS total_conversations, SUM(CASE WHEN ac.ended_at IS NOT NULL THEN 1 ELSE 0 END) AS completed_conversations, SUM(CASE WHEN ac.ended_at IS NULL THEN 1 ELSE 0 END) AS incomplete_conversations FROM agent_conversations ac WHERE ac.started_at >= NOW() - INTERVAL '6 months' GROUP BY month, ac.agent_type ORDER BY month, ac.agent_type;", "dry_run": false}	{"data": [{"count": 25}], "success": true, "row_count": 1, "is_dry_run": false, "execution_time_ms": 65, "validation_results": {"is_safe": true, "estimated_cost": "low", "security_warnings": []}}	anthropic	claude-3-5-sonnet	127	success	\N	6d988ca7-bfe3-4e16-8860-3678acd9b16f	0	f	2025-07-26 02:19:47.01971+00	2025-07-26 02:19:47.199558+00
644233b4-9863-4d14-8d7b-12c6222b7ef5	supabase	execute-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"sql": "SELECT u.id, u.email, u.display_name, COUNT(s.id) AS session_count\\nFROM users u\\nLEFT JOIN sessions s ON u.id = s.user_id AND s.updated_at >= NOW() - INTERVAL '1 week'\\nLEFT JOIN tasks t ON u.id = t.user_id AND t.created_at >= NOW() - INTERVAL '1 week'\\nWHERE s.id IS NOT NULL\\nAND t.id IS NULL\\nGROUP BY u.id\\nHAVING COUNT(s.id) > 1\\nORDER BY MAX(s.updated_at) DESC\\nLIMIT 100;", "dry_run": false}	{"data": [{"count": 6}], "success": true, "row_count": 1, "is_dry_run": false, "execution_time_ms": 71, "validation_results": {"is_safe": true, "estimated_cost": "medium", "security_warnings": []}}	anthropic	claude-3-5-sonnet	134	success	\N	ded959bc-b09e-49ef-8232-5d3d09522b04	0	f	2025-07-26 02:19:56.415003+00	2025-07-26 02:19:56.59902+00
