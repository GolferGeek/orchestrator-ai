7b694c7d-dfbf-4555-97f3-4d74dd3594ac	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show me all users created in the last 30 days", "dry_run": false, "use_context": true}	{"sql": "SELECT id, email, display_name, created_at FROM users WHERE created_at >= NOW() - INTERVAL '30 days' LIMIT 100", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query selects the 'id', 'email', 'display_name', and 'created_at' columns from the 'users' table. It filters the results to include only those users whose 'created_at' timestamp is within the last 30 days by using the condition 'created_at >= NOW() - INTERVAL '30 days''. The query adheres to Supabase constraints by not using any table or column aliases, ensuring that the SELECT statement is simple and straightforward. Additionally, it includes a LIMIT clause to restrict the number of results returned to 100, which is a requirement for safety in Supabase queries.", "execution_time_ms": 3396, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	3506	success	\N	6045c2c4-302c-47fa-8972-24e27862f3a9	0	f	2025-07-26 19:35:08.733027+00	2025-07-26 19:35:12.210768+00
f7f9ff4f-0c68-43c7-bc23-682fdbd38c81	supabase	generate-sql	db94682e-5184-496f-93fd-dc739aa0f9e7	\N	\N	{"prompt": "Show me the top 5 departments by total KPI data points in the last 30 days", "dry_run": false, "use_context": true}	{"sql": "SELECT department_id, COUNT(*) FROM kpi_data WHERE created_at >= NOW() - INTERVAL '30 days' GROUP BY department_id ORDER BY COUNT(*) DESC LIMIT 5", "warnings": [], "confidence": 0.95, "model_used": "anthropic:claude-3-5-sonnet", "explanation": "This query selects the department_id and counts the number of KPI data points for each department from the kpi_data table. It filters the records to include only those created in the last 30 days using the WHERE clause. The results are grouped by department_id to aggregate the counts for each department. The ORDER BY clause sorts the results in descending order based on the count of KPI data points, ensuring that the departments with the highest counts appear first. Finally, the LIMIT clause restricts the output to the top 5 departments. This query adheres to Supabase constraints by avoiding aliases, calculated fields, and complex joins, while ensuring a safety limit is included.", "execution_time_ms": 3311, "validation_results": {"is_valid": true, "security_issues": [], "estimated_complexity": "low"}, "context_patterns_applied": 0}	anthropic	claude-3-5-sonnet	3410	success	\N	32d72496-b5aa-4cba-b928-592a262e78a7	0	f	2025-07-26 19:50:06.910048+00	2025-07-26 19:50:10.279368+00
