# =============================================================================
# AI PROVIDER KEYS
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# A2A PROTOCOL CONFIGURATION
# =============================================================================
A2A_PROTOCOL_VERSION=2.0.0
DEFAULT_HEARTBEAT_INTERVAL=30
DEFAULT_REQUEST_TIMEOUT=30
A2A_MAX_RETRIES=3
A2A_RETRY_DELAY=1.0
A2A_RETRY_BACKOFF_MULTIPLIER=2.0
A2A_DEBUG=false
A2A_LOG_LEVEL=INFO
A2A_LOG_HEARTBEATS=false
A2A_CONTEXT_FILE_NAME=agent_context.md
A2A_AUTO_REGISTER_FABRIC=true
A2A_AUTO_ESTABLISH_RELATIONSHIPS=true

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
ENABLE_EXTERNAL_AGENTS=true
AGENT_BASE_URL=http://localhost
AGENTS_API_PATH=/agents
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=10.0
HTTP_CLIENT_TIMEOUT=30.0

# External Agents
HIVERARCHY_EXTERNAL_ENDPOINT=http://localhost:4100/agents/orchestrator/orchestrator/tasks
HIVERARCHY_API_USER=your_email@example.com
HIVERARCHY_API_PASSWORD=your_password

# =============================================================================
# THIRD PARTY SERVICES
# =============================================================================
TEST_API_SECRET_KEY=test-secret-key-12345
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HELICONE_API_KEY=sk-helicone-xxxxxxx-xxxxxxx-xxxxxxx-xxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=WARNING
PYTHONPATH=.:${PYTHONPATH}
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=orchestrator-ai
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxx

VITE_BASE_URL=http://localhost

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (VITE)
# =============================================================================
VITE_API_BASE_URL=http://localhost:9000
VITE_API_NESTJS_BASE_URL=http://localhost:9000
VITE_APP_ENV=server
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false