# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# Database dumps and temporary files
data_dump.sql
*.dump.sql
*.backup
_supabase/db_cluster-*.backup

# Supabase CLI working directories
/supabase/

# Dependency directories
node_modules/

# Environment variables (ignore actual files, but allow example files)
# Ignore actual environment files
/.env
/.env.local
/.env.development

# Ignore production and server env files specifically (not their .example versions)
/.env.production
/.env.server

# Explicitly allow example files
!/.env.example
!/.env.production.example
!/.env.server.example

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific
.DS_Store

# Build artifacts
.turbo/
apps/api/dist/
apps/web/dist/

# Environment variables
.env

# TaskMaster files - exclude from Git (personal task management)
.taskmaster/
.taskmaster/tasks/
.taskmaster/reports/
.taskmaster/state.json 

# Private agent namespaces (keep internal agents out of public forks)
apps/api/src/agents/my-org/*
!apps/api/src/agents/my-org/README.md
apps/api/src/agents/saas/*
!apps/api/src/agents/saas/README.md

# Private landing variants corresponding to internal namespaces
apps/web/src/views/landing/my-org/*
!apps/web/src/views/landing/my-org/README.md
apps/web/src/views/landing/saas/*
!apps/web/src/views/landing/saas/README.md
apps/web/src/components/landing/my-org/*
!apps/web/src/components/landing/my-org/README.md
apps/web/src/components/landing/saas/*
!apps/web/src/components/landing/saas/README.md

# Task files
# tasks.json
# tasks/

# Large presentation files
docs/keynote/*.key
docs/*.key

# Large export files
exports/clean-data/*.json 
