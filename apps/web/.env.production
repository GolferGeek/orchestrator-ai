# Production environment variables for Orchestrator AI frontend
# This configures the frontend to connect to production API and services

# Production API URL - used by frontend to connect to backend
VITE_API_BASE_URL=https://api.orchestratorai.io

# Production WebSocket URL (Socket.IO will use the same base URL)  
VITE_WS_BASE_URL=https://api.orchestratorai.io

# Production mode
NODE_ENV=production
