SUPABASE_LOCAL_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_LOCAL_DB=orchestrator_ai

# Cloud Supabase (current - add your values)
SUPABASE_URL=your-cloud-supabase-url
SUPABASE_ANON_KEY=your-cloud-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-cloud-service-key

# =============================================================================
# APPLICATION PORTS
# =============================================================================
API_PORT=4000
WEB_PORT=3000

# =============================================================================
# AI SERVICES
# =============================================================================
# Add your actual API keys here
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# Local Ollama (should work with your running instance)
OLLAMA_URL=http://localhost:11434
OLLAMA_ENABLED=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

PROJECT_NAME=Orchestrator-AI
PROJECT_VERSION=1.0.0

# =============================================================================
# DEVELOPMENT FEATURES
# =============================================================================
ENABLE_CORS_ALL=true
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_STACK_TRACES=true

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this to .env and add your real API keys
# 2. Start with SUPABASE_MODE=cloud to test current setup
# 3. Switch to SUPABASE_MODE=local after we set up local Supabase
# 4. SUPABASE_LOCAL_DB can be: orchestrator_ai, hierarchy_ai, client_demo_legal, etc.