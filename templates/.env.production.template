# =============================================================================
# APPLICATION BRANDING
# =============================================================================
COMPANY_NAME=Your Company Name
PRIMARY_COLOR=#1e40af
SECONDARY_COLOR=#3b82f6

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================
# Required: Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: OpenAI API key for additional models
OPENAI_API_KEY=your-openai-api-key

# Optional: Perplexity API key for web search
PERPLEXITY_API_KEY=your-perplexity-api-key

# =============================================================================
# OLLAMA CONFIGURATION (Local AI Models)
# =============================================================================
# Set to false if you have limited RAM (< 16GB)
ENABLE_OLLAMA=true
OLLAMA_URL=http://ollama:11434

# Models to automatically download (comma-separated)
# Options: llama3:8b, llama3:70b, mistral:7b, codellama:7b, phi3:mini
OLLAMA_MODELS=llama3:8b,mistral:7b,codellama:7b

# Memory limits for Ollama (adjust based on your RAM)
OLLAMA_MEMORY_LIMIT=16G
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
GOTRUE_EXTERNAL_EMAIL_ENABLED=false
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=true

# If you want to enable email features:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =============================================================================
# MONITORING AND SECURITY
# =============================================================================
# Generate secure passwords
GRAFANA_PASSWORD=your-grafana-admin-password
GRAFANA_SECRET_KEY=your-grafana-secret-key

# Redis configuration
REDIS_MAX_MEMORY=512mb

# =============================================================================
# BACKUP CONFIGURATION (Optional)
# =============================================================================
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION=7  # Keep backups for 7 days

# Optional: S3 backup configuration
# BACKUP_S3_BUCKET=your-backup-bucket
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Project name for container naming
COMPOSE_PROJECT_NAME=client-ai

# Docker Compose profiles to enable
# Options: gpu, ollama, monitoring, backup, ssl
COMPOSE_PROFILES=ollama,monitoring,ssl

# Logging configuration
LOG_LEVEL=info

# Realtime configuration
REALTIME_ENC_KEY=supabaserealtime
REALTIME_SECRET_KEY=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# Storage configuration
TENANT_ID=stub
REGION=us-east-1
S3_BUCKET=stub

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit this file with real credentials to version control
# 2. Use strong, unique passwords for all services
# 3. Regularly rotate API keys and passwords
# 4. Limit database user permissions in production
# 5. Use environment-specific values for each deployment