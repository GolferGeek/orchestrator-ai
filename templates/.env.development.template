# =============================================================================
# APPLICATION PORTS
# =============================================================================
API_PORT=4000
WEB_PORT=3000

# =============================================================================
# AI SERVICES
# =============================================================================
# Required for AI functionality
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional additional providers
OPENAI_API_KEY=your-openai-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# Local Ollama configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_ENABLED=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

# Project identification
PROJECT_NAME=Orchestrator-AI
PROJECT_VERSION=1.0.0

# =============================================================================
# DATABASE SWITCHING
# =============================================================================
# Switch between different local databases for different projects
# Options: orchestrator_ai, hierarchy_ai, client_demo_legal, client_demo_marketing
CURRENT_DATABASE=orchestrator_ai

# =============================================================================
# DEVELOPMENT FEATURES
# =============================================================================
# Enable additional debugging features
ENABLE_CORS_ALL=true
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_STACK_TRACES=true

# Hot reload settings
CHOKIDAR_USEPOLLING=false
FAST_REFRESH=true

# =============================================================================
# OPTIONAL DEVELOPMENT SERVICES
# =============================================================================
# Redis (for caching in development)
REDIS_URL=redis://localhost:6379

# Monitoring (optional for development)
GRAFANA_URL=http://localhost:3001
PROMETHEUS_URL=http://localhost:9090

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test database (uses separate DB for tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchestrator_ai_test

# Test API keys (use separate keys for testing)
TEST_ANTHROPIC_API_KEY=your-test-anthropic-key

# =============================================================================
# SECURITY (Development)
# =============================================================================
# Less restrictive settings for development
JWT_SECRET=development-jwt-secret-not-for-production
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. This file is for local development only
# 2. Use .env.local for machine-specific overrides
# 3. Never use these credentials in production
# 4. API keys should still be real keys for testing AI features