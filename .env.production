# Production Environment Configuration
# For production deployment

# =============================================================================
# SUPABASE CONFIGURATION - PRODUCTION
# =============================================================================
# These should be set via environment variables or secure config management
SUPABASE_URL=${PRODUCTION_SUPABASE_URL}
SUPABASE_ANON_KEY=${PRODUCTION_SUPABASE_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${PRODUCTION_SUPABASE_SERVICE_ROLE_KEY}
SUPABASE_JWT_SECRET=${PRODUCTION_SUPABASE_JWT_SECRET}
SUPABASE_CORE_SCHEMA=public
SUPABASE_COMPANY_SCHEMA=company

# Test User Configuration (for staging/testing)
SUPABASE_TEST_USER=testuser@yourdomain.com
SUPABASE_TEST_PASSWORD=${PRODUCTION_TEST_PASSWORD}
SUPABASE_TEST_USERID=${PRODUCTION_TEST_USERID}
SYSTEM_USER_ID=${PRODUCTION_SYSTEM_USER_ID}

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
API_PORT=8000
WEB_PORT=3000

# =============================================================================
# AI PROVIDER KEYS
# =============================================================================
# These should be set via secure environment variables
ANTHROPIC_API_KEY=${PRODUCTION_ANTHROPIC_API_KEY}
PERPLEXITY_API_KEY=${PRODUCTION_PERPLEXITY_API_KEY}
OPENAI_API_KEY=${PRODUCTION_OPENAI_API_KEY}
GROK_API_KEY=${PRODUCTION_GROK_API_KEY}
GOOGLE_API_KEY=${PRODUCTION_GOOGLE_API_KEY}

# Ollama (if running locally in production)
OLLAMA_BASE_URL=http://ollama:11434

# =============================================================================
# A2A PROTOCOL CONFIGURATION
# =============================================================================
A2A_PROTOCOL_VERSION=2.0.0
DEFAULT_HEARTBEAT_INTERVAL=60
DEFAULT_REQUEST_TIMEOUT=60
A2A_MAX_RETRIES=5
A2A_RETRY_DELAY=2.0
A2A_RETRY_BACKOFF_MULTIPLIER=2.0
A2A_DEBUG=false
A2A_LOG_LEVEL=INFO
A2A_LOG_HEARTBEATS=false
A2A_CONTEXT_FILE_NAME=agent_context.md
A2A_AUTO_REGISTER_FABRIC=true
A2A_AUTO_ESTABLISH_RELATIONSHIPS=true

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
ENABLE_EXTERNAL_AGENTS=true
AGENT_BASE_URL=https://your-domain.com
AGENTS_API_PATH=/agents
HEARTBEAT_INTERVAL=60
HEARTBEAT_TIMEOUT=20.0
HTTP_CLIENT_TIMEOUT=60.0

# External Agents
HIVERARCHY_EXTERNAL_ENDPOINT=${PRODUCTION_HIVERARCHY_ENDPOINT}
HIVERARCHY_API_USER=${PRODUCTION_HIVERARCHY_USER}
HIVERARCHY_API_PASSWORD=${PRODUCTION_HIVERARCHY_PASSWORD}

# =============================================================================
# THIRD PARTY SERVICES
# =============================================================================
TEST_API_SECRET_KEY=${PRODUCTION_TEST_API_SECRET}
FIRECRAWL_API_KEY=${PRODUCTION_FIRECRAWL_API_KEY}
HELICONE_API_KEY=${PRODUCTION_HELICONE_API_KEY}
DEEPGRAM_API_KEY=${PRODUCTION_DEEPGRAM_API_KEY}
ELEVENLABS_API_KEY=${PRODUCTION_ELEVENLABS_API_KEY}
NOTION_API_KEY=${PRODUCTION_NOTION_API_KEY}

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=INFO
PYTHONPATH=.:${PYTHONPATH}
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=orchestrator-ai-production
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=${PRODUCTION_LANGSMITH_API_KEY}

VITE_BASE_URL=https://your-domain.com